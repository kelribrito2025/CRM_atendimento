# Copie este arquivo para ".env" e ajuste os valores.

# Porta em que o sistema vai rodar (http://localhost:3100)
PORT=3100

# Banco de dados na nuvem (publicação). Quando existe, o CRM usa MySQL/TiDB
# em vez do arquivo local, e os dados não se perdem entre publicações.
# DATABASE_URL=mysql://usuario:senha@servidor:3306/nome_do_banco

# Usuário administrador criado automaticamente no primeiro acesso
ADMIN_NOME=Gestor Bigteck
ADMIN_EMAIL=admin@bigteck.com.br
ADMIN_SENHA=admin123

# true = preenche o CRM com conversas de exemplo para demonstração (false = começa vazio)
DADOS_EXEMPLO=false

# Pede um código de 6 dígitos por e-mail a cada login (true/false)
DOIS_FATORES=false

# Endereço público do sistema, usado nos links de convite e de nova senha.
# Deixe em branco para usar http://localhost:PORT
BASE_URL=

# Marque como true somente quando o sistema estiver publicado com HTTPS
COOKIE_SEGURO=false

# WhatsApp via uazapi (API não oficial). Pegue os dois no painel do uazapi.
# Nunca envie este arquivo para o GitHub.
UAZAPI_URL=https://SEU-SERVIDOR.uazapi.com
UAZAPI_ADMIN_TOKEN=

# Consulta de saldo do cliente pelo PIN (Número Virtual).
# A chave fica SÓ no servidor: o navegador nunca a recebe.
SALDO_TOKEN=
# SALDO_URL=https://app.numero-virtual.com/api/agents/customer/lookup

# Arquivos das conversas guardados no Amazon S3 (bucket privado).
# Sem estas chaves, os arquivos continuam sendo buscados no canal a cada visualização.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_BUCKET=mindi-storage-bucket
# S3_REGION=us-east-1
# S3_PREFIXO=chat-app-numeros

# Chat do site (o cliente conversa pelo painel dele, estilo Intercom).
# O segredo é combinado com o dev do site: ele assina o id do usuário logado
# para ninguém se passar por outro cliente. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WIDGET_SEGREDO=
# Equipe que recebe as conversas vindas do site (id da equipe; em branco = sem equipe)
# WIDGET_EQUIPE_ID=
